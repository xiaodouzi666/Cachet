# ---- PayPal (sandbox only) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_EMAIL=
PUBLISHER_STARLETTE_EMAIL=
PUBLISHER_FASTAPI_EMAIL=
JUDGE_BUYER_EMAIL=            # published in README (sandbox only)
JUDGE_BUYER_PASSWORD=         # published in README (sandbox only)
SANDBOX_TEST_CARD_NUMBER=     # optional, sandbox test card from developer dashboard
SANDBOX_TEST_CARD_EXPIRY=
E2E_PAYMENT=wallet            # select card for unattended runs on a verified sandbox card
# ---- Inference ----
INFERENCE_ENDPOINT_MODE=direct   # set registered on the Render API
TUNNEL_FIXED_URL=                # optional operator-managed HTTPS GPU origin
SGLANG_BASE_URL=http://127.0.0.1:30000
SGLANG_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=         # GPU host only, for an optional named tunnel
MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
TOKENIZER_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
HOSTED_FALLBACK_BASE_URL=     # optional (T4.5)
HOSTED_FALLBACK_API_KEY=
HOSTED_FALLBACK_CALIBRATION= # e.g. /var/data/hosted-calibration.json, measured from this service
HOSTED_FALLBACK_MODEL=
# ---- Copilot LLM (OpenAI-compatible) ----
COPILOT_LLM_BASE_URL=
COPILOT_LLM_API_KEY=
COPILOT_LLM_MODEL=
# ---- Pricing (USD per 1M tokens) ----
PRICE_FULL=1.00
PRICE_SELF=0.10
PRICE_SHARED=0.15
ROYALTY_RATE=0.04
PRICE_OUT=2.00
COLD_FRACTION_DEFAULT=0.25
SLA_FACTOR=2.0
# ---- Settlement ----
CAPTURE_THRESHOLD_USD=2.00
FINAL_CAPTURE_MIN_USD=1.00
PAYPAL_CAPTURE_POLICY=partial        # use final-only if the sandbox app does not support multiple captures
PAYOUT_MIN_USD=0.25
JUDGE_PAYOUT_MIN_USD=0.01
MANDATE_DEFAULT_CAP_USD=5.00
MANDATE_MAX_CAP_USD=20.00
MANDATE_MAX_AGE_H=72
RUN_IDLE_END_MIN=10
# ---- App ----
ADMIN_TOKEN=
BFF_TOKEN=
# Independent operator credential. Configure only the API and the soak runner.
CACHET_SOAK_TOKEN=
DATABASE_URL=sqlite:////var/data/cachet.db
PUBLIC_WEB_URL=
PUBLIC_API_URL=
AG_STUDIO_LICENSE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
